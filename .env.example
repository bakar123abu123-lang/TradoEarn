# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Optional server-side override for Admin Panel access.
ADMIN_PASSWORD=

# SIGNAL_WEBHOOK_SECRET: Shared secret token verified on POST /api/external/signal (x-api-key or Bearer header).
SIGNAL_WEBHOOK_SECRET=

# SIGNAL_ALLOWED_ORIGINS: Optional comma-separated list of browser origins allowed to POST to /api/external/signal.
SIGNAL_ALLOWED_ORIGINS=

# VITE_SUPABASE_URL: Your Supabase project URL.
VITE_SUPABASE_URL="https://coswnrddyrkkpbcjerqu.supabase.co"

# VITE_SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_ANON_KEY: Your Supabase public publishable/anon key (safe for browser).
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# SUPABASE_DB_URL: Direct PostgreSQL connection string template for CLI/psql migrations (replace [YOUR-DATABASE-PASSWORD] locally, never commit real passwords).
SUPABASE_DB_URL="postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.coswnrddyrkkpbcjerqu.supabase.co:5432/postgres"

